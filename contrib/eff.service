[Unit]
Description=eff - Network connectivity monitor
Documentation=https://github.com/taigrr/eff
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/eff --notify
Restart=on-failure
RestartSec=10

# Allow ICMP without root
AmbientCapabilities=CAP_NET_RAW

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

# Pass DBUS session for desktop notifications
# (only works as user service: systemctl --user enable eff)
Environment=DISPLAY=:0

[Install]
WantedBy=default.target
