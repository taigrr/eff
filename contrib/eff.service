[Unit]
Description=eff - Network connectivity monitor
Documentation=https://github.com/taigrr/eff
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/eff --notify
Restart=on-failure
RestartSec=10

# Allow ICMP without root
AmbientCapabilities=CAP_NET_RAW

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

# Pass desktop session details for notifications.
# This unit is intended to run as a user service (`systemctl --user ...`).
Environment=DISPLAY=:0
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=%t/bus
Environment=XDG_RUNTIME_DIR=%t

[Install]
WantedBy=default.target
